<%
  # @configs['module_metadata'] is PDK's own already-computed metadata hash for this
  # pdk update/pdk convert run (PDK::Module::Metadata#data) -- it already has template-ref
  # and pdk-version bumped, and the module's existing fields (author, license, requirements,
  # etc.) merged in. Re-serializing it here, unchanged except for one targeted patch, keeps
  # this in lock-step with PDK's own metadata write rather than replacing it.
  metadata = (@configs['module_metadata'] || {}).dup

  # Per ADR 0004 (docs/adr/0004-*.md), this module's own declared "openvox" requirement no
  # longer drives which gems Gemfile.erb/Rakefile.erb install -- that's decided by the
  # resolved gemsource regime instead. This is now the ONLY place a module's metadata.json
  # architecture declaration still affects template output: an openvox-declaring module is
  # exempted from the puppet requirement ceiling patch below, since ADR 0002's problem
  # (a stale puppet ceiling silently skipping the Puppet 9 test stream) is specific to
  # modules that intend to track Puppet, Inc.'s own puppet releases.
  begin
    requirements = Array(metadata['requirements'])
    targets_openvox = requirements.any? { |r| r['name'] == 'openvox' }
    puppet_requirement = requirements.find { |r| r['name'] == 'puppet' }

    if !targets_openvox && puppet_requirement
      version_requirement = puppet_requirement['version_requirement'].to_s
      upper_bound = version_requirement[/<\s*(\d+(?:\.\d+)*)/, 1]

      if upper_bound.nil? || Gem::Version.new(upper_bound) < Gem::Version.new('10.0.0')
        puppet_requirement['version_requirement'] = if version_requirement.include?('<')
                                                        version_requirement.sub(/<\s*\d+(?:\.\d+)*/, '< 10.0.0')
                                                      else
                                                        "#{version_requirement.strip} < 10.0.0"
                                                      end
      end
    end
  rescue StandardError
    nil
  end
-%>
<%= JSON.pretty_generate(metadata.delete_if { |_key, value| value.nil? }) %>
