<% common = config_for('common') -%>
<% acceptance_flags = Array(@configs['acceptance_flags']) -%>
name: "ci"

on:
  pull_request:
    branches:
      - "main"
  pull_request_target:
    types: [labeled]
    branches:
      - "main"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  # On pull_request_target, github.ref is the base branch, so key on the PR number
  # (and the event) to keep runs of different PRs from cancelling each other.
  group: ${{ github.workflow }}-${{ github.event_name }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  Spec:
    if: github.event_name != 'pull_request_target'
    uses: "puppetlabs/cat-github-actions/.github/workflows/module_ci.yml@main"
    secrets: "inherit"

  Acceptance:
    if: >-
      github.event_name == 'workflow_dispatch' ||
      (github.event_name == 'pull_request' &&
       github.event.pull_request.head.repo.fork == false) ||
      (github.event_name == 'pull_request_target' &&
       github.event.pull_request.head.repo.fork == true &&
       github.event.label.name == 'allowed-for-ci')
    uses: "puppetlabs/cat-github-actions/.github/workflows/module_acceptance.yml@main"
<% unless acceptance_flags.empty? -%>
    with:
      flags: <%= acceptance_flags.join(' ').to_json %>
<% end -%>
    secrets: "inherit"
