<%-
# note that these hashes need to use rockets, not colons, because rubocop config requires strings as keys
defaults = {
  'plugins' => [
    'rubocop-performance',
    'rubocop-hash_inspect',
    'rubocop-rspec',
    'rubocop-rspec_rails',
    'rubocop-factory_bot',
    'rubocop-capybara',
  ],
  'AllCops' => {
    'NewCops' => 'enable',
    'DisplayCopNames' => true,
    'TargetRubyVersion' => 3.1,
    'Include' => [
      '**/*.rb',
    ],
    'Exclude'=> [
      'bin/*',
      '.vendor/**/*',
      '**/Gemfile',
      '**/Rakefile',
      'pkg/**/*',
      'spec/fixtures/**/*',
      'vendor/**/*',
      '**/Puppetfile',
      '**/Vagrantfile',
      '**/Guardfile',
    ],
  },
}

defaults['inherit_from'] = '.rubocop_todo.yml' if @configs['include_todos']
defaults['AllCops']['TargetRubyVersion'] = @configs['TargetRubyVersion'] if @configs['TargetRubyVersion']

require 'deep_merge/core'
selected = @configs['selected_profile']
# YAML 1.1 may coerce an unquoted on/off profile name to true/false; map it back.
selected = { true => 'on', false => 'off' }.fetch(selected, selected)
profiles = @configs['profiles']
raise "profiles must be a Hash, got #{profiles.class}" unless profiles.is_a?(Hash)
profile = profiles[selected]
raise "Unknown rubocop selected_profile #{selected.inspect}; valid: #{profiles.keys.join(', ')}" unless profile.is_a?(Hash) && profile['configs'].is_a?(Hash)
# shallow dup is safe here: the template renders once per process, so there's
# no second render to see defaults mutated by the deep_merge! calls below.
configs = defaults.dup
DeepMerge::deep_merge!(profile['configs'], configs, knockout_prefix: "---", preserve_unmergeables: false)

cop_overrides = @configs['cop_overrides']
raise "cop_overrides must be a Hash, got #{cop_overrides.class}" unless cop_overrides.nil? || cop_overrides.is_a?(Hash)
if cop_overrides && !cop_overrides.empty?
  # PDK's outer .sync.yml merge turns a knockout ('---') into '' rather than
  # deleting the key, so treat an empty value here as the knockout signal.
  knocked_out, cop_overrides = cop_overrides.partition { |_, value| value == '' }.map(&:to_h)
  knocked_out.each_key { |cop| configs.delete(cop) }
  DeepMerge::deep_merge!(cop_overrides, configs, knockout_prefix: "---", preserve_unmergeables: false) unless cop_overrides.empty?
end
-%>
<%= YAML.dump(configs) -%>
